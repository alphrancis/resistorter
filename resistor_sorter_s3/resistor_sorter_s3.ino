/*
 * Resistor sorter - ESP32-S3 (N16R8) + OV2640 camera + TensorFlow Lite Micro
 *
 * Classifies the part in front of the camera as one of MODEL_LABELS
 * (empty / good / bent ...) and prints the result over USB serial.
 * The model is in model_data.h, generated by train_model.py.
 *
 * Arduino IDE settings (Tools menu):
 *   Board:            "ESP32S3 Dev Module"
 *   Flash Size:       16MB
 *   PSRAM:            "OPI PSRAM"
 *   Partition Scheme: "16M Flash (3MB APP/9.9MB FATFS)"  (or any with >= 2MB app)
 *   USB CDC On Boot:  Enabled   (so Serial goes to the USB port)
 * Library:  ESP_TF  (Library Manager)
 *
 * Image pipeline matches training exactly:
 *   SVGA 800x600 JPEG -> RGB -> 5x5 block average -> 160x120 -> int8 (pixel - 128)
 *
 * Serial output, one line per classification:
 *   RESULT,<label>,<confidence 0-100>,<ms>
 */
#include <ESP_TF.h>
#include "esp_camera.h"
#include "img_converters.h"
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
#include "tensorflow/lite/schema/schema_generated.h"
#include "model_data.h"

// ===================== USER SETTINGS =====================
#define MIN_CONFIDENCE   70    // below this (%) the result is reported as "unsure"
#define STABLE_FRAMES    3     // same label this many times in a row before acting
// Optional output pins for the sorter mechanism (-1 = unused).
// The pin for the decided label goes HIGH for PULSE_MS.
static const int LABEL_PINS[MODEL_NUM_CLASSES] = { -1 };   // e.g. {-1, 1, 2} for empty/good/bent
#define PULSE_MS         300
// 1 = send each JPEG + result as binary packets for sorter_viewer.py on the laptop
// 0 = plain text lines only (readable in Arduino Serial Monitor)
#define STREAM_TO_LAPTOP 1
// =========================================================

// ESP32-S3-N16R8 camera board pinout (Freenove / ESP32-S3-EYE style).
// If the camera fails to start, check your board's pin map and edit these.
#define PWDN_GPIO_NUM  -1
#define RESET_GPIO_NUM -1
#define XCLK_GPIO_NUM  15
#define SIOD_GPIO_NUM   4
#define SIOC_GPIO_NUM   5
#define Y9_GPIO_NUM    16
#define Y8_GPIO_NUM    17
#define Y7_GPIO_NUM    18
#define Y6_GPIO_NUM    12
#define Y5_GPIO_NUM    10
#define Y4_GPIO_NUM     8
#define Y3_GPIO_NUM     9
#define Y2_GPIO_NUM    11
#define VSYNC_GPIO_NUM  6
#define HREF_GPIO_NUM   7
#define PCLK_GPIO_NUM  13

#define CAM_W 800
#define CAM_H 600
#define BLOCK (CAM_W / MODEL_IN_W)   // 5
static_assert(CAM_W / MODEL_IN_W == CAM_H / MODEL_IN_H, "camera and model aspect must match");

static const size_t kArenaSize = 2 * 1024 * 1024;   // in PSRAM; real usage printed at boot
static uint8_t *arena = nullptr;
static uint8_t *rgb = nullptr;                       // full-frame RGB888 (actually BGR order)
static tflite::MicroInterpreter *interpreter = nullptr;

static bool initCamera() {
  camera_config_t c = {};
  c.ledc_channel = LEDC_CHANNEL_0;
  c.ledc_timer   = LEDC_TIMER_0;
  c.pin_d0 = Y2_GPIO_NUM;  c.pin_d1 = Y3_GPIO_NUM;  c.pin_d2 = Y4_GPIO_NUM;  c.pin_d3 = Y5_GPIO_NUM;
  c.pin_d4 = Y6_GPIO_NUM;  c.pin_d5 = Y7_GPIO_NUM;  c.pin_d6 = Y8_GPIO_NUM;  c.pin_d7 = Y9_GPIO_NUM;
  c.pin_xclk = XCLK_GPIO_NUM;  c.pin_pclk = PCLK_GPIO_NUM;
  c.pin_vsync = VSYNC_GPIO_NUM;  c.pin_href = HREF_GPIO_NUM;
  c.pin_sccb_sda = SIOD_GPIO_NUM;  c.pin_sccb_scl = SIOC_GPIO_NUM;
  c.pin_pwdn = PWDN_GPIO_NUM;  c.pin_reset = RESET_GPIO_NUM;
  c.xclk_freq_hz = 20000000;
  c.pixel_format = PIXFORMAT_JPEG;      // same as the training images
  c.frame_size   = FRAMESIZE_SVGA;
  c.jpeg_quality = 10;
  c.fb_count     = 2;
  c.fb_location  = CAMERA_FB_IN_PSRAM;
  c.grab_mode    = CAMERA_GRAB_LATEST;
  return esp_camera_init(&c) == ESP_OK;
}

static bool initModel() {
  const tflite::Model *model = tflite::GetModel(model_tflite);
  if (model->version() != TFLITE_SCHEMA_VERSION) {
    Serial.printf("model schema %d != %d\n", (int)model->version(), TFLITE_SCHEMA_VERSION);
    return false;
  }
  static tflite::MicroMutableOpResolver<8> resolver;
  resolver.AddConv2D();
  resolver.AddDepthwiseConv2D();
  resolver.AddAdd();
  resolver.AddMul();
  resolver.AddMean();
  resolver.AddFullyConnected();
  resolver.AddSoftmax();
  resolver.AddReshape();

  arena = (uint8_t *)heap_caps_aligned_alloc(16, kArenaSize, MALLOC_CAP_SPIRAM);
  if (!arena) { Serial.println("arena alloc failed (is PSRAM enabled?)"); return false; }
  static tflite::MicroInterpreter interp(model, resolver, arena, kArenaSize);
  interpreter = &interp;
  if (interpreter->AllocateTensors() != kTfLiteOk) { Serial.println("AllocateTensors failed"); return false; }
  Serial.printf("model %u bytes, arena used %u bytes\n", model_tflite_len,
                (unsigned)interpreter->arena_used_bytes());
  return true;
}

// Fill the model input from one camera frame. Returns false if the frame is bad.
static bool frameToInput(camera_fb_t *fb, int8_t *in) {
  if (fb->width != CAM_W || fb->height != CAM_H) return false;
  if (!fmt2rgb888(fb->buf, fb->len, fb->format, rgb)) return false;   // writes B,G,R
  const int n = BLOCK * BLOCK;
  for (int y = 0; y < MODEL_IN_H; y++) {
    for (int x = 0; x < MODEL_IN_W; x++) {
      uint32_t b = 0, g = 0, r = 0;
      for (int dy = 0; dy < BLOCK; dy++) {
        const uint8_t *p = rgb + ((size_t)(y * BLOCK + dy) * CAM_W + x * BLOCK) * 3;
        for (int dx = 0; dx < BLOCK; dx++, p += 3) { b += p[0]; g += p[1]; r += p[2]; }
      }
      int8_t *o = in + (y * MODEL_IN_W + x) * 3;          // model wants R,G,B
      o[0] = (int8_t)((r + n / 2) / n + MODEL_IN_ZERO);
      o[1] = (int8_t)((g + n / 2) / n + MODEL_IN_ZERO);
      o[2] = (int8_t)((b + n / 2) / n + MODEL_IN_ZERO);
    }
  }
  return true;
}

// ---- laptop link (same frame packet format as esp32cam_uart_stream.ino) ----
//   frame:  A5 5A C3 3C | seq u16 | len u32 | JPEG | sum16 u16
//   result: A5 5A C3 3D | label u8 | conf u8 | ms u16 | decided u8   (label 255 = unsure)
static void sendFrame(const uint8_t *d, size_t n) {
  static uint16_t seq = 0;
  uint8_t h[10] = {0xA5, 0x5A, 0xC3, 0x3C, (uint8_t)seq, (uint8_t)(seq >> 8),
                   (uint8_t)n, (uint8_t)(n >> 8), (uint8_t)(n >> 16), (uint8_t)(n >> 24)};
  seq++;
  uint16_t s = 0;
  for (size_t i = 0; i < n; i++) s += d[i];
  uint8_t t[2] = {(uint8_t)s, (uint8_t)(s >> 8)};
  Serial.write(h, 10); Serial.write(d, n); Serial.write(t, 2);
}

static void sendResult(int label, int conf, uint32_t ms, bool decided) {
  uint8_t p[9] = {0xA5, 0x5A, 0xC3, 0x3D, (uint8_t)label, (uint8_t)conf,
                  (uint8_t)ms, (uint8_t)(ms >> 8), (uint8_t)decided};
  Serial.write(p, sizeof(p));
}

// Called once when a new stable result is decided. Put your sorter logic here.
static void actOn(int label) {
  int pin = LABEL_PINS[label];
  if (pin >= 0) { digitalWrite(pin, HIGH); delay(PULSE_MS); digitalWrite(pin, LOW); }
}

void setup() {
  Serial.begin(115200);
  delay(1500);
  Serial.println("resistor sorter starting");

  for (int i = 0; i < MODEL_NUM_CLASSES; i++)
    if (LABEL_PINS[i] >= 0) { pinMode(LABEL_PINS[i], OUTPUT); digitalWrite(LABEL_PINS[i], LOW); }

  if (!psramFound()) { Serial.println("PSRAM not found - set Tools > PSRAM > OPI PSRAM"); while (true) delay(1000); }
  rgb = (uint8_t *)ps_malloc(CAM_W * CAM_H * 3);
  if (!initCamera()) { Serial.println("camera init failed - check pin map"); while (true) delay(1000); }
  if (!rgb || !initModel()) { while (true) delay(1000); }

  for (int i = 0; i < 5; i++) {   // let auto-exposure settle
    camera_fb_t *fb = esp_camera_fb_get();
    if (fb) esp_camera_fb_return(fb);
  }
  Serial.println("ready");
}

void loop() {
  static int lastLabel = -1, streak = 0, decided = -1;

  uint32_t t0 = millis();
  camera_fb_t *fb = esp_camera_fb_get();
  if (!fb) { delay(10); return; }
  TfLiteTensor *input = interpreter->input(0);
  bool ok = frameToInput(fb, input->data.int8) && interpreter->Invoke() == kTfLiteOk;
  if (!ok) { esp_camera_fb_return(fb); if (!STREAM_TO_LAPTOP) Serial.println("bad frame"); return; }
#if STREAM_TO_LAPTOP
  sendFrame(fb->buf, fb->len);
#endif
  esp_camera_fb_return(fb);

  TfLiteTensor *out = interpreter->output(0);
  int best = 0;
  for (int i = 1; i < MODEL_NUM_CLASSES; i++)
    if (out->data.int8[i] > out->data.int8[best]) best = i;
  float conf = (out->data.int8[best] - out->params.zero_point) * out->params.scale * 100.0f;
  uint32_t ms = millis() - t0;

  bool sure = conf >= MIN_CONFIDENCE;
  bool newDecision = false;
  if (!sure) { streak = 0; lastLabel = -1; }
  else {
    streak = (best == lastLabel) ? streak + 1 : 1;
    lastLabel = best;
    if (streak == STABLE_FRAMES && best != decided) { decided = best; newDecision = true; }
  }

#if STREAM_TO_LAPTOP
  sendResult(sure ? best : 255, (int)(conf + 0.5f), ms, newDecision);
#else
  Serial.printf("RESULT,%s,%.0f,%lu\n", sure ? MODEL_LABELS[best] : "unsure", conf, (unsigned long)ms);
  if (newDecision) Serial.printf("DECIDED,%s\n", MODEL_LABELS[best]);
#endif
  if (newDecision) actOn(best);
}
