/*
 * Real-time resistor classifier - AI-Thinker ESP32-CAM + TensorFlow Lite Micro
 *
 * Prints good / bent / burnt / empty on the Serial Monitor (115200 baud).
 * Model: model_data.h (86 KB), generated by train_fast.py.
 *
 * Arduino IDE settings (Tools menu):
 *   Board:            "AI Thinker ESP32-CAM"
 *   PSRAM:            Enabled
 *   Partition Scheme: "Huge APP (3MB No OTA/1MB SPIFFS)"
 * Library:  ESP_TF  (Library Manager)
 *
 * Pipeline (matches train_fast.py):
 *   QVGA 320x240 JPEG -> RGB565 -> 2x2 block average -> 160x120 RGB -> int8
 * Camera capture runs on core 0 while inference runs on core 1, so a new
 * frame is always ready the moment the model finishes.
 *
 * Output:
 *   good   98%  | 112 ms  8.9 fps
 *   >>> DECIDED: good
 */
#include <ESP_TF.h>
#include "esp_camera.h"
#include "img_converters.h"
#include "soc/soc.h"
#include "soc/rtc_cntl_reg.h"
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
#include "tensorflow/lite/schema/schema_generated.h"
#include "model_data.h"

// ===================== USER SETTINGS =====================
#define MIN_CONFIDENCE   70    // below this (%) the result is "unsure"
#define STABLE_FRAMES    3     // same label this many frames in a row -> DECIDED
#define PRINT_EVERY      1     // print every Nth result (1 = every frame)
#define PRINT_ONLY_CHANGES 0   // 1 = print only DECIDED lines
// =========================================================

#define PWDN_GPIO_NUM  32
#define RESET_GPIO_NUM -1
#define XCLK_GPIO_NUM   0
#define SIOD_GPIO_NUM  26
#define SIOC_GPIO_NUM  27
#define Y9_GPIO_NUM    35
#define Y8_GPIO_NUM    34
#define Y7_GPIO_NUM    39
#define Y6_GPIO_NUM    36
#define Y5_GPIO_NUM    21
#define Y4_GPIO_NUM    19
#define Y3_GPIO_NUM    18
#define Y2_GPIO_NUM     5
#define VSYNC_GPIO_NUM 25
#define HREF_GPIO_NUM  23
#define PCLK_GPIO_NUM  22

#define CAM_W 320
#define CAM_H 240
static_assert(CAM_W == MODEL_IN_W * 2 && CAM_H == MODEL_IN_H * 2, "camera must be 2x model size");

static const size_t kArenaSize = 400 * 1024;
static uint8_t *arena = nullptr;
static tflite::MicroInterpreter *interpreter = nullptr;

// double buffer of decoded RGB565 frames, filled by the camera task
static uint16_t *frameBuf[2];
static volatile int readyIdx = -1;          // index of newest complete frame, -1 = none
static SemaphoreHandle_t frameMutex;
static SemaphoreHandle_t frameReady;

static bool initCamera() {
  camera_config_t c = {};
  c.ledc_channel = LEDC_CHANNEL_0;
  c.ledc_timer   = LEDC_TIMER_0;
  c.pin_d0 = Y2_GPIO_NUM;  c.pin_d1 = Y3_GPIO_NUM;  c.pin_d2 = Y4_GPIO_NUM;  c.pin_d3 = Y5_GPIO_NUM;
  c.pin_d4 = Y6_GPIO_NUM;  c.pin_d5 = Y7_GPIO_NUM;  c.pin_d6 = Y8_GPIO_NUM;  c.pin_d7 = Y9_GPIO_NUM;
  c.pin_xclk = XCLK_GPIO_NUM;  c.pin_pclk = PCLK_GPIO_NUM;
  c.pin_vsync = VSYNC_GPIO_NUM;  c.pin_href = HREF_GPIO_NUM;
  c.pin_sccb_sda = SIOD_GPIO_NUM;  c.pin_sccb_scl = SIOC_GPIO_NUM;
  c.pin_pwdn = PWDN_GPIO_NUM;  c.pin_reset = RESET_GPIO_NUM;
  c.xclk_freq_hz = 20000000;
  c.pixel_format = PIXFORMAT_JPEG;
  c.frame_size   = FRAMESIZE_QVGA;
  c.jpeg_quality = 12;
  c.fb_count     = 2;
  c.fb_location  = CAMERA_FB_IN_PSRAM;
  c.grab_mode    = CAMERA_GRAB_LATEST;
  return esp_camera_init(&c) == ESP_OK;
}

static bool initModel() {
  const tflite::Model *model = tflite::GetModel(model_tflite);
  if (model->version() != TFLITE_SCHEMA_VERSION) return false;
  static tflite::MicroMutableOpResolver<10> resolver;
  resolver.AddConv2D();
  resolver.AddDepthwiseConv2D();
  resolver.AddMaxPool2D();
  resolver.AddReduceMax();
  resolver.AddFullyConnected();
  resolver.AddSoftmax();
  resolver.AddReshape();
  resolver.AddAdd();
  resolver.AddMul();
  resolver.AddQuantize();

  // internal RAM is much faster than PSRAM for the tensor arena; fall back if it doesn't fit
  arena = (uint8_t *)heap_caps_aligned_alloc(16, kArenaSize, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  if (!arena) arena = (uint8_t *)heap_caps_aligned_alloc(16, kArenaSize, MALLOC_CAP_SPIRAM);
  if (!arena) return false;
  static tflite::MicroInterpreter interp(model, resolver, arena, kArenaSize);
  interpreter = &interp;
  if (interpreter->AllocateTensors() != kTfLiteOk) return false;
  Serial.printf("model %u B, arena used %u B\n", model_tflite_len,
                (unsigned)interpreter->arena_used_bytes());
  return true;
}

// Core 0: grab + decode frames continuously.
static void cameraTask(void *) {
  int writeIdx = 0;
  for (;;) {
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) { vTaskDelay(1); continue; }
    bool ok = fb->width == CAM_W && fb->height == CAM_H &&
              jpg2rgb565(fb->buf, fb->len, (uint8_t *)frameBuf[writeIdx], JPG_SCALE_NONE);
    esp_camera_fb_return(fb);
    if (!ok) continue;
    xSemaphoreTake(frameMutex, portMAX_DELAY);
    readyIdx = writeIdx;
    writeIdx = (readyIdx == 0) ? 1 : 0;
    xSemaphoreGive(frameMutex);
    xSemaphoreGive(frameReady);
  }
}

// RGB565 320x240 -> int8 RGB 160x120 by 2x2 averaging.
static inline void unpack(uint16_t px, int &r, int &g, int &b) {
  px = (px >> 8) | (px << 8);                          // jpg2rgb565 writes big-endian
  r = ((px >> 11) & 0x1F) * 255 / 31;
  g = ((px >> 5) & 0x3F) * 255 / 63;
  b = (px & 0x1F) * 255 / 31;
}

static void toInput(const uint16_t *src, int8_t *in) {
  for (int y = 0; y < MODEL_IN_H; y++) {
    const uint16_t *r0 = src + (y * 2) * CAM_W;
    const uint16_t *r1 = r0 + CAM_W;
    for (int x = 0; x < MODEL_IN_W; x++) {
      int R = 0, G = 0, B = 0, r, g, b;
      unpack(r0[2 * x], r, g, b);     R += r; G += g; B += b;
      unpack(r0[2 * x + 1], r, g, b); R += r; G += g; B += b;
      unpack(r1[2 * x], r, g, b);     R += r; G += g; B += b;
      unpack(r1[2 * x + 1], r, g, b); R += r; G += g; B += b;
      int8_t *o = in + (y * MODEL_IN_W + x) * 3;
      o[0] = (int8_t)(((R + 2) >> 2) + MODEL_IN_ZERO);
      o[1] = (int8_t)(((G + 2) >> 2) + MODEL_IN_ZERO);
      o[2] = (int8_t)(((B + 2) >> 2) + MODEL_IN_ZERO);
    }
  }
}

static void halt(const char *m) { Serial.println(m); for (;;) delay(1000); }

void setup() {
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);
  Serial.begin(115200);
  delay(300);
  Serial.println("\nESP32-CAM real-time resistor classifier");
  pinMode(4, OUTPUT); digitalWrite(4, LOW);   // flash LED off

  if (!psramFound()) halt("PSRAM not found - Tools > PSRAM > Enabled");
  if (!initModel()) halt("model init failed");   // before camera so the arena gets internal RAM
  if (!initCamera()) halt("camera init failed");
  for (int i = 0; i < 2; i++) {
    frameBuf[i] = (uint16_t *)ps_malloc(CAM_W * CAM_H * 2);
    if (!frameBuf[i]) halt("frame buffer alloc failed");
  }
  frameMutex = xSemaphoreCreateMutex();
  frameReady = xSemaphoreCreateBinary();
  for (int i = 0; i < 5; i++) { camera_fb_t *fb = esp_camera_fb_get(); if (fb) esp_camera_fb_return(fb); }
  xTaskCreatePinnedToCore(cameraTask, "cam", 4096, nullptr, 5, nullptr, 0);
  Serial.println("ready");
}

void loop() {
  static int lastLabel = -1, streak = 0, decided = -1;
  static uint32_t count = 0, lastT = millis();

  xSemaphoreTake(frameReady, portMAX_DELAY);
  uint32_t t0 = millis();
  xSemaphoreTake(frameMutex, portMAX_DELAY);
  int idx = readyIdx;
  toInput(frameBuf[idx], interpreter->input(0)->data.int8);   // copy out while locked
  xSemaphoreGive(frameMutex);

  if (interpreter->Invoke() != kTfLiteOk) { Serial.println("invoke failed"); return; }
  TfLiteTensor *out = interpreter->output(0);
  int best = 0;
  for (int i = 1; i < MODEL_NUM_CLASSES; i++)
    if (out->data.int8[i] > out->data.int8[best]) best = i;
  int conf = (int)((out->data.int8[best] - out->params.zero_point) * out->params.scale * 100.0f + 0.5f);

  uint32_t now = millis();
  float fps = 1000.0f / max<uint32_t>(1, now - lastT);
  lastT = now;
  bool sure = conf >= MIN_CONFIDENCE;

  if (!PRINT_ONLY_CHANGES && (++count % PRINT_EVERY) == 0)
    Serial.printf("%-7s %3d%%  | %lu ms  %.1f fps\n", sure ? MODEL_LABELS[best] : "unsure",
                  conf, (unsigned long)(now - t0), fps);

  if (!sure) { streak = 0; lastLabel = -1; return; }
  streak = (best == lastLabel) ? streak + 1 : 1;
  lastLabel = best;
  if (streak >= STABLE_FRAMES && best != decided) {
    decided = best;
    Serial.printf(">>> DECIDED: %s\n", MODEL_LABELS[best]);
  }
}

